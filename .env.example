# Copy this file to .env and fill in real values. .env is git-ignored.

# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Required: chat ids allowed to use the bot (comma-separated). Send the bot any
# message and it replies with your chat id.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: chat id that receives health-check alerts (codex/claude or Google auth broken)
BIZCARD_ALERT_CHAT_ID=

# Parser: auto (openai when an API key is stored, else codex, else claude) | openai | codex | claude
# openai uses OPENAI_API_KEY below, else the file named by BIZCARD_OPENAI_ENV_FILE,
# else ~/.config/openai/credentials.env.
# When an API call fails the bot falls back to the codex/claude CLI.
# OPENAI_API_KEY=
# BIZCARD_PARSER=auto
# BIZCARD_OPENAI_MODEL=gpt-6-luna
# BIZCARD_REASONING_EFFORT=low
# Cross-check: with ANTHROPIC_API_KEY set, each card is also read by Claude Haiku
# in parallel; phones are merged and verified against the OCR text, and
# conflicting names/companies are flagged. BIZCARD_CROSSCHECK=off disables it.
# ANTHROPIC_API_KEY=
# BIZCARD_ANTHROPIC_MODEL=claude-haiku-5-5
# BIZCARD_CODEX_MODEL=gpt-5.6-luna
# BIZCARD_CLAUDE_MODEL=haiku
# BIZCARD_PARSER_TIMEOUT=90

# Cards processed at the same time (album uploads, saves)
# BIZCARD_WORKERS=30
# Minimum seconds between bot messages to one chat (Telegram throttles bursts)
# BIZCARD_TELEGRAM_INTERVAL=0.35

# Python interpreter that has cv2, numpy, PIL (default: python3 on PATH)
# BIZCARD_PYTHON=/path/to/python3

GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND=file   # gws key in ~/.config/gws/.encryption_key
