# Copy this file to .env and fill in real values. .env is git-ignored.

# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Required: chat ids allowed to use the bot (comma-separated). Send the bot any
# message and it replies with your chat id.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: chat id that receives health-check alerts (codex/claude or Google auth broken)
BIZCARD_ALERT_CHAT_ID=

# Parser: auto (codex if installed, else claude) | codex | claude
# BIZCARD_PARSER=auto
# BIZCARD_CODEX_MODEL=gpt-5.6-luna
# BIZCARD_CLAUDE_MODEL=haiku
# BIZCARD_PARSER_TIMEOUT=90

# Python interpreter that has cv2, numpy, PIL (default: python3 on PATH)
# BIZCARD_PYTHON=/path/to/python3
